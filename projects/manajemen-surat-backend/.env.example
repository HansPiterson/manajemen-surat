# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/manajemen_surat

# HTTP server
PORT=3001
HOST=0.0.0.0
PUBLIC_URL=http://SERVER_IP:3001

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend origin; use the exact website origin in production
CORS_ORIGIN=http://WEBSITE_HOST
